# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file or real secrets.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_LOG_LEVEL=INFO

# Database (Supabase Postgres connection string in production).
# Leave unset locally to use SQLite automatically.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Google Gemini API (used by the AI nutrition assistant, Phase 6).
# Leave unset to run with the AI assistant disabled (the rest of the app
# works fully without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_DAILY_LIMIT=20

# Supabase Storage (S3-compatible) for user-uploaded media, e.g. community
# post images. Leave unset to store uploads on local disk instead (fine
# for local dev; not durable across redeploys on most hosts).
# Get these from the Supabase dashboard: Project Settings -> Storage ->
# S3 Connection ("New access key" generates the key ID/secret pair; the
# endpoint and region are shown on the same page).
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_REGION=
SUPABASE_S3_BUCKET=community-images
