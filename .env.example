# Copy this file to .env and fill in real values for your environment.
# Never commit the actual .env file or real secrets.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True

# Database (Supabase Postgres connection string in production).
# Leave unset locally to use SQLite automatically.
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Google Gemini API (used by the AI nutrition assistant, Phase 6).
GEMINI_API_KEY=
